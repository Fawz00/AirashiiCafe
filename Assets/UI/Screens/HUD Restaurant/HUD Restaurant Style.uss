.pause-button {
    width: 72px;
    height: 72px;
    background-color: rgba(0, 0, 0, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 4px;
    padding-right: 8px;
    padding-bottom: 28px;
    padding-left: 8px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    font-size: 0;
    border-left-color: rgba(0, 0, 0, 0.5);
    border-right-color: rgba(0, 0, 0, 0.5);
    border-top-color: rgba(0, 0, 0, 0.5);
    border-bottom-color: rgba(0, 0, 0, 0.5);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-image: url("project://database/Assets/Textures/Circle%20Button.png?fileID=2800000&guid=c9501a5f971f1c64590d5619bbf728e2&type=3#Circle Button");
}

.pause-button:hover {
    width: 72px;
    height: 72px;
    background-color: rgba(0, 0, 0, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 4px;
    padding-right: 8px;
    padding-bottom: 28px;
    padding-left: 8px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    font-size: 0;
    border-left-color: rgba(0, 0, 0, 0.5);
    border-right-color: rgba(0, 0, 0, 0.5);
    border-top-color: rgba(0, 0, 0, 0.5);
    border-bottom-color: rgba(0, 0, 0, 0.5);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-image: url("project://database/Assets/Textures/Circle%20Button.png?fileID=2800000&guid=c9501a5f971f1c64590d5619bbf728e2&type=3#Circle Button");
    -unity-background-image-tint-color: rgb(231, 231, 231);
}

.pause-button:active {
    width: 72px;
    height: 72px;
    background-color: rgba(0, 0, 0, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 16px;
    padding-right: 8px;
    padding-bottom: 16px;
    padding-left: 8px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    font-size: 0;
    border-left-color: rgba(0, 0, 0, 0.5);
    border-right-color: rgba(0, 0, 0, 0.5);
    border-top-color: rgba(0, 0, 0, 0.5);
    border-bottom-color: rgba(0, 0, 0, 0.5);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-image: url("project://database/Assets/Textures/Circle%20Button%20Pressed.png?fileID=2800000&guid=701fe326a54df7e41b572586b83496b1&type=3#Circle Button Pressed");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

#time_bar .unity-progress-bar__background {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.12);
    border-radius: 10px;
    border-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
}

#time_bar .unity-progress-bar__progress {
    background-color: rgb(0, 255, 85);
    border-radius: 5px;
}

#time_bar .unity-progress-bar__label {
    color: black;
    unity-font-style: bold;
}

#time_bar Label {
    color: rgb(255, 255, 255);
    unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Jersey10-Regular.ttf?fileID=12800000&guid=bb3b3302e4839f4498ed266c08827d3c&type=3#Jersey10-Regular");
    font-size: 35px;
}
